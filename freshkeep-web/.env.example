# FreshKeep — Environment Variables Template
# Copy this file to .env and fill in your real credentials
# NEVER commit the actual .env file to GitHub

# ─────────────────────────────────────────────────────────────────
# FIREBASE (Web Client SDK — VITE_ prefix required for browser use)
# Get these from: https://console.firebase.google.com → Project Settings → Your Apps
# ─────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────────
# GEMINI AI (Backend only — NO VITE_ prefix, never sent to browser)
# Get yours FREE at: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
